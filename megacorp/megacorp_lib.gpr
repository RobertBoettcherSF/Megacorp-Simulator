--  Static library of the Megacorp core. Every interface unit is
--  compiled, including the package shells that later items fill in.
with "switches.gpr";

project Megacorp_Lib is
   for Source_Dirs use ("src");
   for Object_Dir use "obj/lib";
   for Library_Dir use "lib";
   for Library_Name use "megacorp";
   for Library_Kind use "static";
   for Create_Missing_Dirs use "True";
   for Library_Interface use
     ("Megacorp",
      "Megacorp.Parameters",
      "Megacorp.Host",
      "Megacorp.Types",
      "Megacorp.RNG",
      "Megacorp.Assets",
      "Megacorp.Assets.Placeholder",
      "Megacorp.Data",
      "Megacorp.Data.Virtual_FS",
      "Megacorp.Data.Virtual_FS.Native",
      "Megacorp.World",
      "Megacorp.World.Gen",
      "Megacorp.Map",
      "Megacorp.Map.Gen",
      "Megacorp.Path",
      "Megacorp.Peds",
      "Megacorp.Actions",
      "Megacorp.Behaviour",
      "Megacorp.Weapons",
      "Megacorp.Shots",
      "Megacorp.Vehicles",
      "Megacorp.Mission",
      "Megacorp.Mission.Gen",
      "Megacorp.Agents",
      "Megacorp.Research",
      "Megacorp.Session",
      "Megacorp.Save",
      "Megacorp.API");

   package Compiler is
      for Default_Switches ("Ada") use Switches.Ada;
   end Compiler;

   package Builder is
      for Default_Switches ("Ada") use ("-j0");
   end Builder;
end Megacorp_Lib;
